# Archivo solo de documentación: muestra qué variables usa M4, sin valores reales.
# El .env real NO está en el repo (RNF-06).
# Guardarlo como .env en la raíz del repo. Ver supabase/README.md.

# --- Base de datos ---
# Supabase: Dashboard -> Connect -> Session pooler.
# Docker local: postgresql://postgres:postgres@db:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<contraseña>@<host-del-pooler>:5432/postgres
DB_SCHEMA=m4
DB_SSL=true
